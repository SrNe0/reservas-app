# Copia este archivo a .env y ajusta los valores. El .env real nunca se sube al repo.
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambiame
# Puerto del host para conectarte a Postgres desde tu PC
DB_PORT=5432
# Puerto del host para la API
API_PORT=8080
# Clave con la que la API firma los tokens JWT (mínimo 32 caracteres). Genera una propia, por ejemplo: openssl rand -base64 48
JWT_SECRET=valor-de-ejemplo-cambialo-por-una-clave-larga-y-aleatoria
# Vida del access token, en minutos
JWT_EXPIRACION_MINUTOS=15
